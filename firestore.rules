rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.owner == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isOwner());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['owner']);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner']);

      allow delete: if false;

      match /feedback/{feedbackId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Sauvegarde privée de l'historique de pointage.
      // Un utilisateur ne peut lire/modifier/supprimer que ses propres données.
      match /pointages/{pointageId} {
        allow read, create, update, delete: if isSignedIn()
          && request.auth.uid == userId;
      }
    }

    match /{path=**}/feedback/{feedbackId} {
      allow read, update: if isOwner();
      allow create, delete: if false;
    }

    match /snake_scores/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 447
        && request.resource.data.displayName is string;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestScore <= 447
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bestScore', 'displayName', 'updatedAt']);

      allow delete: if false;
    }
  }
}
