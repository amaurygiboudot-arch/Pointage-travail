rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.owner == true;
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isOwner();

      allow create: if isOwnUser(userId)
        && !request.resource.data.keys().hasAny(['owner']);

      allow update: if isOwnUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner']);

      allow delete: if false;

      match /feedback/{feedbackId} {
        allow read: if isOwnUser(userId);
        allow create: if isOwnUser(userId);
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read, write: if isOwnUser(userId);
      }

      // Historique HoraTrack : strictement privé au compte connecté.
      // Le document doit rester sous users/{uid}/pointages/{id}; aucun accès croisé.
      match /pointages/{pointageId} {
        allow read, create, update, delete: if isOwnUser(userId);
      }

      // Sauvegarde complète des préférences et fichiers utilisateur.
      // Ces documents peuvent contenir des réglages sensibles (GPS, salaire, etc.)
      // et ne sont donc jamais lisibles par le mode propriétaire/admin.
      match /appBackup/{backupId} {
        allow read, create, update, delete: if isOwnUser(userId);
      }
    }

    match /{path=**}/feedback/{feedbackId} {
      allow read, update: if isOwner();
      allow create, delete: if false;
    }

    match /snake_scores/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 447
        && request.resource.data.displayName is string;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestScore <= 447
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bestScore', 'displayName', 'updatedAt']);

      allow delete: if false;
    }
  }
}
