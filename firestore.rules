rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.owner == true;
    }

    function validProfile(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoUrl', 'lastLoginAt',
          'platform', 'providers', 'owner'
        ])
        && d.uid == userId
        && d.uid is string
        && d.uid.size() <= 128
        && d.lastLoginAt == request.time
        && d.platform is string
        && d.platform in ['android', 'ios']
        && (!('displayName' in d) || d.displayName == null || (d.displayName is string && d.displayName.size() <= 200))
        && (!('email' in d) || d.email == null || (d.email is string && d.email.size() <= 320))
        && (!('photoUrl' in d) || d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 2048))
        && (!('providers' in d) || (d.providers is list && d.providers.size() <= 10
          && d.providers.hasOnly(['google.com', 'apple.com'])))
        && (!('owner' in d) || d.owner is bool);
    }

    function validDeviceCreate(deviceId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'installationId', 'displayModel', 'manufacturer', 'model', 'device',
          'product', 'androidVersion', 'sdkInt', 'appVersionName',
          'appVersionCode', 'packageName', 'platform', 'active',
          'lastSeenAt', 'firstSeenAt'
        ])
        && d.installationId == deviceId
        && d.installationId is string && d.installationId.size() <= 128
        && d.displayModel is string && d.displayModel.size() <= 256
        && d.manufacturer is string && d.manufacturer.size() <= 128
        && d.model is string && d.model.size() <= 128
        && d.device is string && d.device.size() <= 128
        && d.product is string && d.product.size() <= 128
        && d.androidVersion is string && d.androidVersion.size() <= 64
        && d.sdkInt is int && d.sdkInt >= 23 && d.sdkInt <= 100
        && d.appVersionName is string && d.appVersionName.size() <= 64
        && d.appVersionCode is int && d.appVersionCode >= 0
        && d.packageName is string && d.packageName.size() <= 256
        && d.platform == 'android'
        && d.active is bool
        && d.lastSeenAt == request.time
        && d.firstSeenAt == request.time;
    }

    function validDeviceUpdate(deviceId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'installationId', 'displayModel', 'manufacturer', 'model', 'device',
          'product', 'androidVersion', 'sdkInt', 'appVersionName',
          'appVersionCode', 'packageName', 'platform', 'active',
          'lastSeenAt', 'firstSeenAt'
        ])
        && d.installationId == deviceId
        && d.installationId is string && d.installationId.size() <= 128
        && d.displayModel is string && d.displayModel.size() <= 256
        && d.manufacturer is string && d.manufacturer.size() <= 128
        && d.model is string && d.model.size() <= 128
        && d.device is string && d.device.size() <= 128
        && d.product is string && d.product.size() <= 128
        && d.androidVersion is string && d.androidVersion.size() <= 64
        && d.sdkInt is int && d.sdkInt >= 23 && d.sdkInt <= 100
        && d.appVersionName is string && d.appVersionName.size() <= 64
        && d.appVersionCode is int && d.appVersionCode >= 0
        && d.packageName is string && d.packageName.size() <= 256
        && d.platform == 'android'
        && d.active is bool
        && d.lastSeenAt == request.time
        && d.firstSeenAt == resource.data.firstSeenAt
        && !d.diff(resource.data).affectedKeys().hasAny(['installationId', 'firstSeenAt', 'packageName']);
    }

    function validFeedbackCreate(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'text', 'createdAt', 'status', 'platform', 'uid', 'installationId',
          'appVersionName', 'appVersionCode', 'androidVersion', 'sdkInt',
          'manufacturer', 'model', 'reviewOnly', 'ownerApprovalRequired'
        ])
        && d.uid == userId
        && d.uid is string
        && d.text is string && d.text.size() > 0 && d.text.size() <= 4000
        && d.createdAt == request.time
        && d.status == 'new'
        && d.platform == 'android'
        && d.installationId is string && d.installationId.size() <= 128
        && d.appVersionName is string && d.appVersionName.size() <= 64
        && d.appVersionCode is int && d.appVersionCode >= 0
        && d.androidVersion is string && d.androidVersion.size() <= 64
        && d.sdkInt is int && d.sdkInt >= 23 && d.sdkInt <= 100
        && d.manufacturer is string && d.manufacturer.size() <= 128
        && d.model is string && d.model.size() <= 128
        && d.reviewOnly == true
        && d.ownerApprovalRequired == true;
    }

    function validFeedbackOwnerUpdate() {
      let d = request.resource.data;
      return d.keys() == resource.data.keys()
        && d.diff(resource.data).affectedKeys().hasOnly(['status'])
        && d.status is string
        && d.status in ['new', 'accepted', 'rejected', 'done'];
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isOwner());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['owner'])
        && validProfile(userId);

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner'])
        && validProfile(userId);

      allow delete: if false;

      match /feedback/{feedbackId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && validFeedbackCreate(userId);
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && validDeviceCreate(deviceId);
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && validDeviceUpdate(deviceId);
        allow delete: if false;
      }
    }

    match /{path=**}/feedback/{feedbackId} {
      allow read: if isOwner();
      allow update: if isOwner() && validFeedbackOwnerUpdate();
      allow create, delete: if false;
    }

    match /snake_scores/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'bestScore', 'displayName', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 447
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'bestScore', 'displayName', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= resource.data.bestScore
        && request.resource.data.bestScore <= 447
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bestScore', 'displayName', 'updatedAt']);

      allow delete: if false;
    }
  }
}
