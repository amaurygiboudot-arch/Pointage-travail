<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Même esprit que les boutons Carbone : chrome + fibre -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FFFFFF" android:centerColor="#8A9095" android:endColor="#24272A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0B0C0D" />
            <stroke android:width="1dp" android:color="#E7EBEE" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#17191B" android:centerColor="#323639" android:endColor="#0D0E0F" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#28FFFFFF" android:centerColor="#05000000" android:endColor="#1A000000" />
            <stroke android:width="1dp" android:color="#4E5357" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
