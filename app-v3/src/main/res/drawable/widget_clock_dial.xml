<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#030303"/>
            <stroke android:width="6dp" android:color="#5A3908"/>
            <size android:width="94dp" android:height="94dp"/>
        </shape>
    </item>

    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="58dp" android:startColor="#242424" android:centerColor="#0D0D0D" android:endColor="#020202"/>
            <stroke android:width="5dp" android:color="#F0D078"/>
            <size android:width="94dp" android:height="94dp"/>
        </shape>
    </item>

    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#7D5414"/>
        </shape>
    </item>
</layer-list>
