<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cadre chrome externe -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#F5F7F8" android:centerColor="#7A7F84" android:endColor="#202326" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Liseré sombre -->
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#070809" />
            <stroke android:width="1dp" android:color="#DCE1E5" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Fond carbone -->
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#111315" android:centerColor="#2A2E31" android:endColor="#0B0C0D" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Trame carbone en surimpression -->
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#22FFFFFF" android:centerColor="#02000000" android:endColor="#18000000" />
            <stroke android:width="1dp" android:color="#34383B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
