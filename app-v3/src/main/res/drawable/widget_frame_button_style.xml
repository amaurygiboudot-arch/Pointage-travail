<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#FFE274" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#055BDC" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#FFCA3E" />
        </shape>
    </item>
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <!-- Même principe que les boutons de l'application : surface sombre/translucide
                 à l'intérieur du cadre, sans rendre le widget opaque. -->
            <solid android:color="#4D10141C" />
            <gradient android:angle="270" android:startColor="#5CFFFFFF" android:centerColor="#261A2230" android:endColor="#52000000" />
            <stroke android:width="1dp" android:color="#FFF8BE" />
        </shape>
    </item>
</layer-list>
