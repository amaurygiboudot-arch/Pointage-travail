<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hp_black"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/luxury_hero"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Décor HP Travail" />

            <com.amaury.pointage.HpAnalogClockView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <Button
                android:id="@+id/salaryBackButton"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible"
                android:text="" />
        </FrameLayout>

        <com.amaury.pointage.SalaryNavBarView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/hp_panel"
            android:gravity="center"
            android:padding="14dp"
            android:text="S A L A I R E"
            android:textColor="@color/hp_gold_light"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/hp_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TAUX HORAIRE BRUT" android:textColor="@color/hp_gold" android:textSize="15sp" android:textStyle="bold"/>
            <EditText android:id="@+id/hourlyRateInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Ex. 13,70" android:imeOptions="actionDone" android:inputType="numberDecimal" android:textColor="@color/hp_white" android:textColorHint="@color/hp_grey"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="DATE D'ENTRÉE DANS L'ENTREPRISE" android:textColor="@color/hp_gold" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:id="@+id/employmentStartDateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Date d'entrée : non renseignée" android:textColor="@color/hp_white" android:textSize="15sp"/>
            <Button android:id="@+id/chooseEmploymentStartDateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/hp_panel" android:text="CHOISIR LA DATE D'ENTRÉE" android:textColor="@color/hp_gold_light"/>

            <com.amaury.pointage.EnterpriseLookupView
                android:id="@+id/enterpriseLookupView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <com.amaury.pointage.CompanyControlsView
                android:id="@+id/companyControlsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="CONVENTION COLLECTIVE" android:textColor="@color/hp_gold" android:textSize="15sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/selectedConventionText" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/hp_panel" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp" android:text="Plasturgie — IDCC 0292" android:textColor="@color/hp_white" android:textSize="15sp"/>
                <Button android:id="@+id/searchConventionButton" android:layout_width="60dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:background="@drawable/hp_panel" android:text="🔎" android:textColor="@color/hp_gold_light" android:textSize="22sp"/>
            </LinearLayout>
            <TextView android:id="@+id/conventionRuleStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Règles Plasturgie intégrées" android:textColor="@color/hp_grey" android:textSize="12sp"/>

            <TextView android:id="@+id/salaryMonthText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mois" android:textColor="@color/hp_white" android:textSize="16sp"/>
            <Button android:id="@+id/chooseSalaryMonthButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/hp_panel" android:text="CHOISIR LE MOIS" android:textColor="@color/hp_gold_light"/>
            <Button android:id="@+id/calculateSalaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/hp_panel" android:text="RECALCULER" android:textColor="@color/hp_gold_light"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/hp_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="R É S U L T A T S   D U   M O I S" android:textColor="@color/hp_gold_light" android:textSize="14sp" android:fontFamily="serif"/>
            <LinearLayout android:id="@+id/salaryResultContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Le calcul se met à jour automatiquement lorsque tu modifies le taux horaire, la date d'entrée, le mois ou la convention." android:textColor="@color/hp_grey" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>