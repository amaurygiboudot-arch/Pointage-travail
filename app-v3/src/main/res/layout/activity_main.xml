<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v3_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/v3_panel"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♛"
                android:textColor="@color/v3_gold"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HP TRAVAIL"
                android:textColor="@color/v3_gold_light"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="V3 • interface XML"
                android:textColor="@color/v3_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/v3_panel"
            android:padding="8dp">

            <TextView android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="◷\nAUJOURD'HUI" android:textColor="@color/v3_gold_light" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="▥\nHISTORIQUE" android:textColor="@color/v3_text_muted" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="◔\nANALYSES" android:textColor="@color/v3_text_muted" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="€\nSALAIRE" android:textColor="@color/v3_text_muted" android:textSize="11sp" />
            <TextView android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:text="⚙\nPARAMÈTRES" android:textColor="@color/v3_text_muted" android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="STATUT ACTUEL\n● AUCUNE ENTRÉE EN COURS"
            android:textColor="@color/v3_text"
            android:textSize="20sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <Button
                    android:id="@+id/entryButton"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:background="@drawable/v3_action_green"
                    android:text="↪"
                    android:textColor="@color/v3_gold_light"
                    android:textSize="48sp"
                    android:elevation="10dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="E N T R É E" android:textColor="@color/v3_gold_light" android:textSize="15sp" />
            </LinearLayout>

            <TextView android:layout_width="32dp" android:layout_height="match_parent" android:gravity="center" android:text="♛" android:textColor="@color/v3_gold" android:textSize="24sp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <Button
                    android:id="@+id/exitButton"
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:background="@drawable/v3_action_red"
                    android:text="↩"
                    android:textColor="@color/v3_gold_light"
                    android:textSize="48sp"
                    android:elevation="10dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="S O R T I E" android:textColor="@color/v3_gold_light" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/manualButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/v3_panel"
            android:text="✎  SAISIE MANUELLE DES HEURES"
            android:textColor="@color/v3_gold_light"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="HISTORIQUE DU JOUR"
            android:textColor="@color/v3_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/v3_panel"
            android:padding="16dp"
            android:text="Aucun pointage pour le moment."
            android:textColor="@color/v3_text"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
