<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape>
            <solid android:color="#050505"/>
            <corners android:radius="25dp"/>
            <stroke android:width="3dp" android:color="#5C3A08"/>
        </shape>
    </item>

    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="2dp">
        <shape>
            <gradient android:angle="90" android:startColor="#1C1C1C" android:centerColor="#0E0E0E" android:endColor="#050505"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="#E8C868"/>
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/>
        </shape>
    </item>

    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="5dp">
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="21dp"/>
            <stroke android:width="1dp" android:color="#7C5718"/>
        </shape>
    </item>
</layer-list>
