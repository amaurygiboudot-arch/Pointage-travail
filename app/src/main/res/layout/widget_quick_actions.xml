<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/quick_entry"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <TextView
            android:id="@+id/quick_entry_button"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_action_entry_new"
            android:gravity="center"
            android:text="↦"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_entry_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ENTRÉE"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_pause"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <TextView
            android:id="@+id/quick_pause_icon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_action_pause_new"
            android:gravity="center"
            android:text="Ⅱ"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_pause_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="PAUSE"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_exit"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">
        <TextView
            android:id="@+id/quick_exit_button"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_action_exit_new"
            android:gravity="center"
            android:text="↣"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/quick_exit_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SORTIE"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>