<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="7dp">

    <LinearLayout
        android:id="@+id/quick_entry"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Entrée"
            android:scaleType="centerInside"
            android:src="@drawable/luxury_entry" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTRÉE"
            android:textColor="#67E26E"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="56dp"
        android:background="#5C9A6E17" />

    <LinearLayout
        android:id="@+id/quick_pause"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/quick_pause_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/widget_pause_orange"
            android:gravity="center"
            android:text="Ⅱ"
            android:textColor="#FFF4E3"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quick_pause_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAUSE"
            android:textColor="#F3A64A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="56dp"
        android:background="#5C9A6E17" />

    <LinearLayout
        android:id="@+id/quick_exit"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Sortie"
            android:scaleType="centerInside"
            android:src="@drawable/luxury_exit" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SORTIE"
            android:textColor="#FF5A52"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
