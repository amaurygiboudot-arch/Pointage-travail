<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hp_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/salaryBackButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="‹"
                android:textSize="30sp"
                android:textColor="@color/hp_gold"
                android:background="@drawable/hp_panel"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SALAIRE"
                android:textColor="@color/hp_gold"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hp_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TAUX HORAIRE BRUT"
                android:textColor="@color/hp_gold"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/hourlyRateInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Ex. 13,70"
                android:inputType="numberDecimal"
                android:textColor="@color/hp_white"
                android:textColorHint="@color/hp_grey"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CONVENTION COLLECTIVE"
                android:textColor="@color/hp_gold"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectedConventionText"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/hp_panel"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:text="Plasturgie — IDCC 0292"
                    android:textColor="@color/hp_white"
                    android:textSize="15sp"/>

                <Button
                    android:id="@+id/searchConventionButton"
                    android:layout_width="60dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hp_panel"
                    android:text="🔎"
                    android:textColor="@color/hp_gold_light"
                    android:textSize="22sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/conventionRuleStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Règles Plasturgie intégrées"
                android:textColor="@color/hp_grey"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/salaryMonthText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mois"
                android:textColor="@color/hp_white"
                android:textSize="16sp"/>

            <Button
                android:id="@+id/chooseSalaryMonthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CHOISIR LE MOIS"
                android:textColor="@color/hp_gold_light"
                android:background="@drawable/hp_panel"/>

            <Button
                android:id="@+id/calculateSalaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="CALCULER LE SALAIRE"
                android:textColor="@color/hp_gold_light"
                android:background="@drawable/hp_panel"/>
        </LinearLayout>

        <TextView
            android:id="@+id/salaryResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/hp_panel"
            android:padding="16dp"
            android:text="Entre ton taux horaire, choisis la convention et le mois puis lance le calcul."
            android:textColor="@color/hp_white"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Lorsque les règles spécifiques d'une convention ne sont pas encore intégrées, l'application applique le régime légal à titre indicatif et l'indique clairement."
            android:textColor="@color/hp_grey"
            android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
