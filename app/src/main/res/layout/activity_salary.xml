<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hp_black" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<Button android:id="@+id/salaryBackButton" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/hp_panel" android:text="‹" android:textColor="@color/hp_gold" android:textSize="30sp" />
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="SALAIRE" android:textColor="@color/hp_gold" android:textSize="24sp" android:textStyle="bold"/><TextView android:layout_width="56dp" android:layout_height="56dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/hp_panel" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TAUX HORAIRE BRUT" android:textColor="@color/hp_gold" android:textSize="15sp" android:textStyle="bold"/>
<EditText android:id="@+id/hourlyRateInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="Ex. 13,70" android:imeOptions="actionDone" android:inputType="numberDecimal" android:textColor="@color/hp_white" android:textColorHint="@color/hp_grey"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="DATE D'ENTRÉE DANS L'ENTREPRISE" android:textColor="@color/hp_gold" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/employmentStartDateText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Date d'entrée : non renseignée" android:textColor="@color/hp_white" android:textSize="15sp"/>
<Button android:id="@+id/chooseEmploymentStartDateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/hp_panel" android:text="CHOISIR LA DATE D'ENTRÉE" android:textColor="@color/hp_gold_light"/>

<com.amaury.pointage.EnterpriseLookupView
    android:id="@+id/enterpriseLookupView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp" />

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="CONVENTION COLLECTIVE" android:textColor="@color/hp_gold" android:textSize="15sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/selectedConventionText" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/hp_panel" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp" android:text="Plasturgie — IDCC 0292" android:textColor="@color/hp_white" android:textSize="15sp"/><Button android:id="@+id/searchConventionButton" android:layout_width="60dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:background="@drawable/hp_panel" android:text="🔎" android:textColor="@color/hp_gold_light" android:textSize="22sp"/></LinearLayout>
<TextView android:id="@+id/conventionRuleStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Règles Plasturgie intégrées" android:textColor="@color/hp_grey" android:textSize="12sp"/>
<TextView android:id="@+id/salaryMonthText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mois" android:textColor="@color/hp_white" android:textSize="16sp"/>
<Button android:id="@+id/chooseSalaryMonthButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/hp_panel" android:text="CHOISIR LE MOIS" android:textColor="@color/hp_gold_light"/>
<Button android:id="@+id/calculateSalaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/hp_panel" android:text="RECALCULER" android:textColor="@color/hp_gold_light"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="RÉSULTATS DU MOIS" android:textColor="@color/hp_gold" android:textSize="17sp" android:textStyle="bold"/>
<LinearLayout android:id="@+id/salaryResultContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Le calcul se met à jour automatiquement lorsque tu modifies le taux horaire, la date d'entrée, le mois ou la convention. La prime d'ancienneté dépend des règles réellement prévues par la convention collective et éventuellement par l'accord d'entreprise." android:textColor="@color/hp_grey" android:textSize="12sp"/>
</LinearLayout></ScrollView>
