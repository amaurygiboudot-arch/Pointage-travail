<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/luxury_hero"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:cropToPadding="false"
                android:contentDescription="Décor HP Travail" />

            <com.amaury.pointage.HpAnalogClockView
                android:id="@+id/heroClockHands"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <TextView android:id="@+id/logoText" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0" android:text="HP TRAVAIL" />
            <TextClock android:id="@+id/clockDigital" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0" android:format24Hour="HH:mm:ss" />
            <Button android:id="@+id/settingsButton" android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="2dp" android:background="@android:color/transparent" android:text="" android:contentDescription="Paramètres" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/hp_nav_panel" android:paddingTop="7dp" android:paddingBottom="7dp">
            <TextView android:id="@+id/tabToday" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:text="◷\nAUJOURD'HUI" android:textColor="@color/hp_gold_light" android:textSize="10sp" android:fontFamily="serif"/>
            <TextView android:id="@+id/tabHistory" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:text="▥\nHISTORIQUE" android:textColor="@color/hp_grey" android:textSize="10sp" android:fontFamily="serif"/>
            <TextView android:id="@+id/tabAnalytics" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:text="◔\nANALYSES" android:textColor="@color/hp_grey" android:textSize="10sp" android:fontFamily="serif"/>
            <com.amaury.pointage.SalaryTabTextView android:id="@+id/tabSalary" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:text="€\nSALAIRE" android:textColor="@color/hp_grey" android:textSize="10sp" android:fontFamily="serif"/>
            <TextView android:id="@+id/tabSettings" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:text="⚙\nPARAMÈTRES" android:textColor="@color/hp_grey" android:textSize="9sp" android:fontFamily="serif"/>
        </LinearLayout>

        <TextView android:id="@+id/statusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/hp_panel" android:gravity="center" android:padding="14dp" android:text="STATUT ACTUEL\n●  AUCUNE ENTRÉE EN COURS" android:textColor="@color/hp_gold_light" android:textSize="16sp" android:fontFamily="serif" android:letterSpacing="0.08"/>

        <LinearLayout android:id="@+id/pointageButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/hp_panel" android:paddingTop="10dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <Button android:id="@+id/entryButton" android:layout_width="145dp" android:layout_height="135dp" android:background="@drawable/luxury_entry" android:text="" android:contentDescription="Entrée"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="E N T R É E" android:textColor="@color/hp_gold_light" android:textSize="15sp" android:fontFamily="serif"/>
            </LinearLayout>
            <TextView android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:text="♛" android:textColor="@color/hp_gold" android:textSize="22sp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <Button android:id="@+id/exitButton" android:layout_width="145dp" android:layout_height="135dp" android:background="@drawable/luxury_exit" android:text="" android:contentDescription="Sortie"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="S O R T I E" android:textColor="@color/hp_gold_light" android:textSize="15sp" android:fontFamily="serif"/>
            </LinearLayout>
        </LinearLayout>

        <com.amaury.pointage.ManualHoursButton
            android:id="@+id/manualHoursButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/hp_panel"
            android:text="✎  SAISIE MANUELLE DES HEURES"
            android:textColor="@color/hp_gold_light"
            android:textSize="14sp" />

        <LinearLayout android:id="@+id/contentPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/hp_panel" android:padding="14dp">
            <TextView android:id="@+id/contentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="H I S T O R I Q U E   D U   J O U R" android:textColor="@color/hp_gold_light" android:textSize="14sp" android:fontFamily="serif"/>
            <TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="Aucun pointage aujourd'hui." android:textColor="@color/hp_white" android:textSize="15sp" android:fontFamily="serif"/>
            <LinearLayout android:id="@+id/analyticsPdfPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RAPPORT PDF MENSUEL" android:textColor="@color/hp_gold_light" android:textSize="15sp" android:fontFamily="serif"/>
                <TextView android:id="@+id/selectedReportMonthText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mois sélectionné" android:textColor="@color/hp_white" android:textSize="14sp"/>
                <Button android:id="@+id/chooseReportMonthButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="CHOISIR LE MOIS" android:textColor="@color/hp_gold_light" android:background="@drawable/hp_panel"/>
                <com.amaury.pointage.PreviewPdfButton android:id="@+id/generateMonthlyPdfButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="GÉNÉRER LE PDF" android:textColor="@color/hp_gold_light" android:background="@drawable/hp_panel"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Le PDF contient le total du mois, le récapitulatif par adresse et le détail complet des entrées/sorties." android:textColor="@color/hp_grey" android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/gpsSettingsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="12dp">
                <com.amaury.pointage.LocationManagementView android:id="@+id/locationManagementView" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <EditText android:id="@+id/workplaceAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:inputType="textPostalAddress|textMultiLine" android:textColor="@color/hp_white" android:textColorHint="@color/hp_grey"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Rayon de déclenchement (mètres)" android:textColor="@color/hp_gold_light" android:textSize="14sp"/>
                <EditText android:id="@+id/geofenceRadius" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="150" android:textColor="@color/hp_white" android:textColorHint="@color/hp_grey"/>
                <Switch android:id="@+id/autoGpsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Pointage automatique par GPS" android:textColor="@color/hp_white"/>
                <TextView android:id="@+id/gpsStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="GPS automatique désactivé" android:textColor="@color/hp_grey" android:textSize="13sp"/>
                <Button android:id="@+id/saveGpsSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ENREGISTRER LES LIEUX" android:textColor="@color/hp_gold_light" android:background="@drawable/hp_panel"/>
                <Button android:id="@+id/locationPermissionButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="AUTORISER LA LOCALISATION" android:textColor="@color/hp_gold_light" android:background="@drawable/hp_panel"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
