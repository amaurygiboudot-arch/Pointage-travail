<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="7dp">

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="♛"
            android:textColor="#F3D58A"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="H P"
            android:textColor="#E7BD5A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="TRAVAIL"
            android:textColor="#D6A84B"
            android:textSize="7sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_entry"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/widget_green"
            android:gravity="center"
            android:text="↪"
            android:textColor="#F7D77C"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="ENTRÉE"
            android:textColor="#E8C25E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_entry_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#62D96B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp">

        <AnalogClock
            android:id="@+id/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/widget_clock_dial"
            android:hand_hour="@drawable/widget_clock_hour"
            android:hand_minute="@drawable/widget_clock_minute" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="HP"
            android:textColor="#D6A84B"
            android:textSize="8sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_exit"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/widget_red"
            android:gravity="center"
            android:text="↪"
            android:textColor="#F7D77C"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="SORTIE"
            android:textColor="#E8C25E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_exit_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FF4D45"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:background="@drawable/widget_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="5dp"
        android:paddingTop="4dp"
        android:paddingEnd="5dp"
        android:paddingBottom="4dp">

        <TextClock
            android:id="@+id/widget_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:textColor="#DDB34E"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PRÊT"
            android:textColor="#E8C25E"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="00h 00m"
            android:textColor="#F3D58A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:background="#806B4A1D" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAUSE"
            android:textColor="#D6A84B"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00h 00m"
            android:textColor="#CFC7B8"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
