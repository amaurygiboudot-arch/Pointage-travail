<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.55"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_crown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♛"
            android:textColor="#F3D58A"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_hp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H P"
            android:textColor="#E7BD5A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_work"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="TRAVAIL"
            android:textColor="#D6A84B"
            android:textSize="6sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_entry_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1.05"
        android:background="@drawable/widget_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/widget_entry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Entrée"
            android:scaleType="centerInside"
            android:src="@drawable/luxury_entry" />

        <TextView
            android:id="@+id/widget_entry_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTRÉE"
            android:textColor="#E8C25E"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_entry_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#59DB60"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_entry_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="#D8D1C3"
            android:textSize="6sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_weight="1.35">

        <ImageView
            android:id="@+id/widget_clock_face"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:contentDescription="Cadran de l'horloge"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_clock_luxury" />

        <AnalogClock
            android:id="@+id/widget_clock"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:dial="@android:color/transparent"
            android:hand_hour="@drawable/widget_clock_hour"
            android:hand_minute="@drawable/widget_clock_minute" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_exit_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1.05"
        android:background="@drawable/widget_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="3dp">

        <ImageView
            android:id="@+id/widget_exit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Sortie"
            android:scaleType="centerInside"
            android:src="@drawable/luxury_exit" />

        <TextView
            android:id="@+id/widget_exit_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SORTIE"
            android:textColor="#E8C25E"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_exit_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FF5B52"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_exit_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text=""
            android:textColor="#D8D1C3"
            android:textSize="6sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_status_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:layout_weight="1.55"
        android:background="@drawable/widget_status_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp">

        <TextClock
            android:id="@+id/widget_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:textColor="#DDB34E"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PRÊT"
            android:textColor="#F3D58A"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00h 00m"
            android:textColor="#F3D58A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="#806B4A1D"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_pause_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAUSE "
                android:textColor="#D6A84B"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00h 00m"
                android:textColor="#CFC7B8"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="📍 Aucune zone"
            android:textColor="#E0B64E"
            android:textSize="6sp" />
    </LinearLayout>
</LinearLayout>
